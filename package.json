{
  "name": "bok-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "check": "vue-tsc --noEmit",
    "predeploy": "npm run build",
    "deploy": "cp dist/index.html dist/404.html && cp CNAME dist/CNAME && gh-pages -d dist"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^6.4.2",
    "@fortawesome/free-brands-svg-icons": "^6.4.2",
    "@fortawesome/free-regular-svg-icons": "^6.4.2",
    "@fortawesome/free-solid-svg-icons": "^6.4.2",
    "@fortawesome/vue-fontawesome": "^3.0.3",
    "@kouts/vue-modal": "^5.0.0",
    "@kyvg/vue3-notification": "^3.0.2",
    "@primeuix/themes": "^3.1.0",
    "@vuepic/vue-datepicker": "^7.2.0",
    "@vvo/tzdb": "^6.110.0",
    "animate.css": "^4.1.1",
    "axios": "^1.6.2",
    "luxon": "^3.4.3",
    "primeflex": "^3.3.1",
    "primeicons": "^6.0.1",
    "primevue": "^4.5.5",
    "vue": "^3.5.13",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "dotenv": "^16.3.1",
    "gh-pages": "^6.0.0",
    "typescript": "^5.7.2",
    "vite": "^8.3.6",
    "vue-tsc": "^3.3.14"
  }
}
